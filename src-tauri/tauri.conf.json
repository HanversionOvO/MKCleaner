{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MkCleaner",
  "version": "0.1.1",
  "identifier": "app.mkcleaner.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MkCleaner",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QjEwMjQ0MDZDOTEyQzgKUldUSUVza0dSQUt4ZEFkd2w3Q0ZNMFNwT2xwL05jSVFaeVRUbTIxU3MrREkydkZZMHg4MTZ3blUK",
      "endpoints": [
        "https://github.com/HanversionOvO/MKCleaner/releases/latest/download/latest-{{target}}.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mole": "mole",
      "../LICENSE": "license/LICENSE.txt"
    },
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  }
}
